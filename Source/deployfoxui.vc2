	PROCEDURE Destroy
		dodefault()
		close databases all
		This.oEngine = .NULL.
		
	ENDPROC

	PROCEDURE displaytask		&& Displays the settings for the selected task
		lparameters tlNew, ;
			tlForce
		local lcControl, ;
			lcFile, ;
			lcUIFile
		select curProject
		if This.cTaskID <> curProject.ID or tlForce
			This.cTaskID   = curProject.ID
			This.cTaskType = lower(trim(Task))
			if not empty(This.cTaskType)
				select curTaskTypes
				locate for lower(Type) = This.cTaskType
				lcFile   = trim(File)
				lcUIFile = trim(UIFile)
				select curProject
				lcControl = 'This.' + This.cTaskType
				if type(lcControl) <> 'O'
					This.NewObject(This.cTaskType, This.cTaskType + 'UI', lcUIFile, '', ;
						This.cTaskType, lcFile, This.oEngine.oVariables)
					with &lcControl
						.lSaveAnchor = .T.
						.Left        = This.shpSettings.Left + 10
						.Top         = This.shpSettings.Top  + 10
						.Width       = This.shpSettings.Width  - 20
						.Height      = This.shpSettings.Height - 20
						.lSaveAnchor = .F.
						.Visible     = .T.
					endwith
				endif type(lcControl) <> 'O'
				with &lcControl
					if tlNew
						.oTask = newobject(This.cTaskType, lcFile, '', This.oEngine.oVariables)
					else
						.oTask.GetSettings(Settings, .T.)
					endif tlNew
				endwith
			endif not empty(This.cTaskType)
			This.Refresh()
		
		* Disable most controls if this is a template task.
		
			store empty(curProject.Source) to This.cboTaskType.Enabled, ;
				This.txtName.Enabled, ;
				This.chkIncomplete.Enabled, ;
				This.chkAlwaysRun.Enabled, ;
				This.edtComments.Enabled, ;
				&lcControl..Enabled
		endif This.cTaskID <> curProject.ID ...
		
	ENDPROC

	PROCEDURE Init
		This.cRegistryKey = ccREGISTRY_KEY
		dodefault()
		
		This.oEngine = newobject('DeployFoxEngine', 'DeployFoxEngine.prg')
		
		* Create a cursor for data binding.
		
		This.oEngine.CreateProject('curProject', .T.)
		select *, space(20) as Status ;
			from curProject ;
			into cursor curProject readwrite
		
		* Set up cboTaskType.
		
		select Descrip, Type ;
			from curTaskTypes ;
			order by Descrip ;
			into array This.cboTaskType.aItems
		This.cboTaskType.Requery()
		
		* Set up the grid
		
		This.grdTasks.RecordSource = 'curProject'
		This.SetupGrid()
		This.BindControls = .T.
		
	ENDPROC

	PROCEDURE openproject		&& Opens the specified project
		lparameters tcProject
		This.grdTasks.RecordSource = ''
		llOpened = This.oEngine.OpenProject(tcProject)
		if llOpened
			This.grdTasks.RecordSource = 'curProject'
			This.SetupGrid()
			This.DisplayTask(.F., .T.)
		else
			messagebox(This.oEngine.cErrorMessage, MB_ICONSTOP, 'DeployFox')
		endif llOpened
		
	ENDPROC

	PROCEDURE savetask		&& Saves the current task
		lparameters tlQuiet
		local lcControl, ;
			lcSettings
		lcControl = 'This.' + Thisform.cTaskType
		do case
			case empty(curProject.Name) and not tlQuiet
				messagebox('Please enter the name of the task.', MB_ICONEXCLAMATION, ;
					'DeployFox')
			case not empty(curProject.Source)
				&& handle template task
				This.UpdateProject()
			case &lcControl..Validate()
				&lcControl..SaveSettings()
				lcSettings = evaluate(lcControl + '.oTask.SaveSettings()')
				replace Settings with lcSettings in curProject
				This.UpdateProject()
			case not tlQuiet
				messagebox('The settings for this task are incomplete.', MB_ICONINFORMATION, 'DeployFox')
		endcase
		
	ENDPROC

	PROCEDURE setupgrid		&& Sets up the grid
		with This.grdTasks
			.Column1.ControlSource    = 'curProject.Order'
			.Column1.DynamicBackColor = 'iif(not empty(Source), rgb(128, 255, 0), rgb(255, 255, 255))'
			.Column2.ControlSource    = 'curProject.Name'
			.Column2.DynamicBackColor = 'icase(Incomplete, rgb(255, 128, 0), AlwaysRun, rgb(255, 248, 220), rgb(255, 255, 255))'
			.Column2.DynamicForeColor = "iif(Incomplete, rgb(255, 255, 255), rgb(0, 0, 0))"
			.Column3.ControlSource    = 'curProject.Task'
			.Column4.ControlSource    = 'curProject.Active'
			.Column5.ControlSource    = 'curProject.Status'
			.Column5.DynamicBackColor = "icase(Status = 'Failed', rgb(255, 0, 0), " + ;
				"Status = 'Success', rgb(0, 255, 0), " + ;
				"rgb(255, 255, 255))"
			.Column5.DynamicForeColor = "iif(Status = 'Failed', rgb(255, 255, 255), rgb(0, 0, 0))"
		endwith
		
	ENDPROC

	PROCEDURE updateproject		&& Updates the selected record in the project
		local lnRecno, ;
			llNew, ;
			lcID, ;
			loRecord
		select curProject
		lnRecno = recno()
		llNew   = empty(ID)
		if llNew
			lcID = sys(2015)
			replace ID with lcID
			append blank in ProjectFile
			replace ID with lcID in ProjectFile
		endif llNew
		scatter name loRecord memo
		
		* Blank most things for template tasks.
		
		if not empty(curProject.Source)
			store '' to loRecord.Task, loRecord.Name, loRecord.Comments, loRecord.Settings
			store .F. to loRecord.Incomplete, loRecord.AlwaysRun
		endif not empty(curProject.Source)
		
		select ProjectFile
		locate for ID = loRecord.ID
		lnOldOrder = Order
		if not deleted('curProject')
			gather name loRecord memo
		endif not deleted('curProject')
		
		* Reorder tasks if the order changed.
		
		if lnOldOrder <> loRecord.Order
			select ID, Order ;
				from ProjectFile ;
				where Order >= loRecord.Order and ID <> loRecord.ID ;
				order by Order ;
				into cursor curOrder readwrite
			lnCurrOrder = loRecord.Order
			scan
				lnCurrOrder = lnCurrOrder + This.oEngine.TaskIncrement
				select ProjectFile
				locate for ID = curOrder.ID
				replace Order with lnCurrOrder
				select curProject
				locate for ID = curOrder.ID
				replace Order with lnCurrOrder
			endscan
			use
		endif lnOldOrder <> loRecord.Order
		select curProject
		go lnRecno
		This.grdTasks.Refresh()
		
	ENDPROC

	PROCEDURE updaterun		&& Updates the status of running the project
		lparameters tcID, ;
			tcStatus, ;
			tcMessage
		local lnSelect, ;
			lnRecno
		lnSelect = select()
		select curProject
		lnRecno = recno()
		locate for ID = tcID
		replace Status with tcStatus
		if between(lnRecno, 1, reccount())
			go lnRecno
		endif between(lnRecno, 1, reccount())
		select (lnSelect)
		This.grdTasks.Refresh()
		if not empty(tcMessage)
			messagebox(tcMessage, MB_ICONSTOP, 'DeployFox')
		endif not empty(tcMessage)
		
	ENDPROC

	PROCEDURE cboTaskType.InteractiveChange
		dodefault()
		Thisform.DisplayTask(.T., .T.)
		
	ENDPROC

	PROCEDURE cboTaskType.Refresh
		* This is only enabled for a new record.
		
		This.Enabled = empty(ID)
		
	ENDPROC

	PROCEDURE cmdClone.Click
		local lcProject
		lcProject = GetFileName('DeployFox Project (*.dbf):dbf', '', 'Clone Project', .T.)
		if not empty(lcProject)
			select ProjectFile
			copy to (lcProject)
			Thisform.OpenProject(lcProject)
		endif not empty(lcProject)
		
	ENDPROC

	PROCEDURE cmdClone.Refresh
		This.Enabled = not empty(Thisform.oEngine.cProjectFile)
		
	ENDPROC

	PROCEDURE cmdCloneTask.Click
		local loRecord
		select curProject
		scatter memo name loRecord
		calculate max(Order) to lnOrder
		loRecord.Order = lnOrder + Thisform.oEngine.TaskIncrement
		loRecord.ID    = ''
		insert into curProject from name loRecord
		Thisform.grdTasks.Refresh()
		Thisform.DisplayTask()
		Thisform.cboTaskType.SetFocus()
		
	ENDPROC

	PROCEDURE cmdCloneTask.Refresh
		This.Enabled = not empty(curProject.Task)
		
	ENDPROC

	PROCEDURE cmdDebug.Click
		local lnRecno, ;
			llReturn, ;
			llLast
		select curProject
		lnRecno = recno()
		scan
			replace Status with ''
		endscan
		Thisform.grdTasks.Refresh()
		
		* Run all the "always run" tasks.
		
		bindevent(Thisform.oEngine, 'Update', Thisform, 'UpdateRun')
		llReturn = Thisform.oEngine.AlwaysRun()
		
		* Run the tasks from the selected one to the end.
		
		go lnRecno
		if llReturn
			scan rest for not AlwaysRun and not Incomplete
				Thisform.DisplayTask()
				llReturn = Thisform.oEngine.RunTask(ID, Name, Task, Settings, .T.)
				skip
				llLast = eof()
				skip -1
				do case
					case not llReturn
						exit
					case not llLast and messagebox('Click OK to run the next task or Cancel to stop.', ;
						MB_OKCANCEL + MB_ICONINFORMATION, 'DeployFox') = IDCANCEL
					exit
				endcase
			endscan rest ...
		endif llReturn
		unbindevent(Thisform.oEngine)
		if messagebox('Run complete. Would you like to view the log file?', ;
			MB_YESNO + MB_ICONINFORMATION, 'DeployFox') = IDYES
			OpenFile(Thisform.oEngine.cLogFile)
		endif messagebox ...
		go lnRecno
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdDebug.Refresh
		select count(*) as Cnt ;
			from curProject ;
			into cursor curTasks
		This.Enabled = not empty(Thisform.oEngine.cProjectFile) and curTasks.Cnt > 0
		use in curTasks
		select curProject
		
	ENDPROC

	PROCEDURE cmdDeleteTask.Click
		local lnOrder
		if messagebox('Delete this task?', MB_YESNO + MB_ICONQUESTION, 'DeployFox') = IDYES
			lnOrder = curProject.Order
			delete in curProject
		
		* Renumber the other tasks.
		
			replace Order with 0 in curProject
			Thisform.UpdateProject()
		
		* Delete the task in ProjectFile.
		
			select ProjectFile
			locate for ID = curProject.ID
			delete
		
		* Display the next record.
		
			select curProject
			locate for Order = lnOrder
			if not found()
				go bottom
			endif not found()
			Thisform.DisplayTask(.F., .T.)
		endif messagebox...
		
	ENDPROC

	PROCEDURE cmdDeleteTask.Refresh
		This.Enabled = not empty(curProject.Task)
		
	ENDPROC

	PROCEDURE cmdDown.Click
		local lcID, ;
			lnNewOrder, ;
			lnCurrOrder
		select curProject
		skip
		lcID       = ID
		lnNewOrder = Order
		skip -1
		lnCurrOrder = Order
		replace Order with lnNewOrder
		Thisform.UpdateProject()
		locate for ID = lcID
		replace Order with lnCurrOrder
		Thisform.UpdateProject()
		locate for Order = lnNewOrder
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdDown.Refresh
		select max(Order) as Order ;
			from curProject ;
			into cursor curMaxOrder
		This.Enabled = not empty(Thisform.oEngine.cProjectFile) and ;
			curProject.Order < nvl(curMaxOrder.Order, 0)
		use in curMaxOrder
		select curProject
		
	ENDPROC

	PROCEDURE cmdNewProject.Click
		local lcProject
		lcProject = GetFileName('DeployFox Project (*.dbf):dbf', '', 'New DeployFox Project', .T.)
		if not empty(lcProject)
			Thisform.oEngine.NewProject(lcProject)
			Thisform.OpenProject(lcProject)
		endif not empty(lcProject)
		
	ENDPROC

	PROCEDURE cmdNewTask.Click
		select curProject
		calculate max(Order) to lnOrder
		append blank in curProject
		replace Order with lnOrder + Thisform.oEngine.TaskIncrement, ;
				Task with 'SetVariable', ;
				Active with .T. ;
			in curProject
		Thisform.DisplayTask(.T., .T.)
		Thisform.cboTaskType.SetFocus()
		
	ENDPROC

	PROCEDURE cmdNewTask.Refresh
		This.Enabled = not empty(Thisform.oEngine.cProjectFile)
		
	ENDPROC

	PROCEDURE cmdOpenProject.buttonclicked
		local lcProject
		lcProject = GetFileName('DeployFox Project (*.dbf):dbf', '', 'Select DeployFox Project')
		if not empty(lcProject)
			Thisform.OpenProject(lcProject)
		endif not empty(lcProject)
		
	ENDPROC

	PROCEDURE cmdOpenProject.shortcutmenu
		lparameters toMenu,	;
			tcObject
		local laProjects[1], ;
			lnProjects, ;
			lnI, ;
			lcProject, ;
			lcCommand
		lnProjects = Thisform.oEngine.oRecentProjects.GetItems(@laProjects)
		for lnI = 1 to lnProjects
			lcProject = laProjects[lnI, 1]
			lcCommand = '_screen.ActiveForm.OpenProject([' + lcProject + '])'
			toMenu.AddBar(lcProject, lcCommand)
		next loProject
		dodefault(toMenu, tcObject)
		
	ENDPROC

	PROCEDURE cmdOpenProject.showmenu
		dodefault()
		if vartype(This.oMenu) = 'O'
			This.oMenu.Release()
			This.oMenu = NULL
		endif vartype(This.oMenu) = 'O'
		
	ENDPROC

	PROCEDURE cmdRun.Click
		select curProject
		replace all Status with ''
		go top
		Thisform.grdTasks.Refresh()
		bindevent(Thisform.oEngine, 'Update', Thisform, 'UpdateRun')
		Thisform.oEngine.Run()
		unbindevent(Thisform.oEngine)
		if messagebox('Run complete. Would you like to view the log file?', ;
			MB_YESNO + MB_ICONINFORMATION, 'DeployFox') = IDYES
			OpenFile(Thisform.oEngine.cLogFile)
		endif messagebox ...
		
	ENDPROC

	PROCEDURE cmdRun.Refresh
		select count(*) as Cnt ;
			from curProject ;
			into cursor curTasks
		This.Enabled = not empty(Thisform.oEngine.cProjectFile) and curTasks.Cnt > 0
		use in curTasks
		select curProject
		
	ENDPROC

	PROCEDURE cmdSave.Click
		Thisform.SaveTask()
		
	ENDPROC

	PROCEDURE cmdSave.Refresh
		This.Enabled = not empty(curProject.Name)
		
	ENDPROC

	PROCEDURE cmdSettings.Click
		local loForm
		loForm = newobject('DeployFoxSettings', 'DeployFoxUI.vcx', '', Thisform.oEngine)
		loForm.Show()
		
	ENDPROC

	PROCEDURE cmdTemplate.Click
		lcFileName = GetFileName('DBF', '', 'Select Template')
		if empty(lcFileName)
			return
		endif empty(lcFileName)
		try
			use (lcFileName) alias Template in 0
		catch to loException
			lcMessage = 'Error opening ' + lcFileName + ': ' + ;
				loException.Message
		endtry
		
		* Ensure the user selected a DeployFox table.
		
		if used('Template')
			lnFields     = afields(laFields,     'ProjectFile')
			lnTestFields = afields(laTestFields, 'Template')
			llOK = lnFields = lnTestFields
			if llOK
				for lnI = 1 to lnFields
					llOK = laFields[lnI, 1] == laTestFields[lnI, 1] and ;
						laFields[lnI, 2] = laTestFields[lnI, 2]
					if not llOK
						exit
					endif not llOK
				next lnI
			endif llOK
		
		* Display the template form.
		
			if llOK
				loForm = newobject('DeployFoxTemplate', 'DeployFoxUI.vcx')
				loForm.Show()
				if used('TemplateTasks')
		
		* Add selected tasks to the project.
		
					select TemplateTasks
					scan
						lcID = TemplateTasks.ID
						select curProject
						locate for ID = lcID
						if not found()
							select Template
							locate for ID = lcID
							append blank in curProject
							replace ID with lcID, ;
									Task with Template.Task, ;
									Name with Template.Name, ;
									Incomplete with Template.Incomplete, ;
									AlwaysRun with Template.AlwaysRun, ;
									Settings with Template.Settings, ;
									Comments with Template.Comments, ;
									Order with Template.Order, ;
									Active with .T., ;
									Source with lcFileName ;
								in curProject
							append blank in ProjectFile
							replace ID with lcID in ProjectFile
							Thisform.UpdateProject()
						endif not found()
					endscan
		
		* Remove removed template tasks from the project.
		
					select curProject
					scan for not empty(Source)
						select TemplateTasks
						locate for ID = curProject.ID
						if not found()
							delete in curProject
							select ProjectFile
							locate for ID = curProject.ID
							delete
						endif not found()
					endscan for not empty(Source)
					use in TemplateTasks
					go top in curProject
		
		* Renumber tasks and display the first one.
		
		replace Order with 0 in curProject
		Thisform.UpdateProject()
					Thisform.DisplayTask(.F., .T.)
					Thisform.cboTaskType.SetFocus()
				endif used('TemplateTasks')
			else
				messagebox(lcFileName + ' is not DeployFox project file.', 16, 'DeployFox')
				return .F.
			endif llOK
		else
			messagebox(lcMessage, 16, 'DeployFox')
			return .F.
		endif used('Template')
		
	ENDPROC

	PROCEDURE cmdTemplate.Refresh
		This.Enabled = not empty(Thisform.oEngine.cProjectFile)
		
	ENDPROC

	PROCEDURE cmdToggleAllActive.Click
		local lnRecno, ;
			llAllActive, ;
			llNewValue
		select curProject
		lnRecno = recno()
		
		* Check if all tasks are active
		llAllActive = .T.
		scan
			if not Active
				llAllActive = .F.
				exit
			endif not Active
		endscan
		
		* Toggle: if all are active, set all to false; otherwise set all to true
		llNewValue = not llAllActive
		
		* Update all records
		scan
			replace Active with llNewValue
			Thisform.UpdateProject()
		endscan
		
		* Restore record position
		if between(lnRecno, 1, reccount())
			go lnRecno
		endif between(lnRecno, 1, reccount())
		
		Thisform.grdTasks.Refresh()
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdToggleAllActive.Refresh
		select count(*) as Cnt ;
			from curProject ;
			into cursor curTasks
		This.Enabled = not empty(Thisform.oEngine.cProjectFile) and curTasks.Cnt > 0
		use in curTasks
		select curProject
		
		
	ENDPROC

	PROCEDURE cmdUp.Click
		local lcID, ;
			lnNewOrder, ;
			lnCurrOrder
		select curProject
		skip -1
		lcID       = ID
		lnNewOrder = Order
		skip
		lnCurrOrder = Order
		replace Order with lnNewOrder
		Thisform.UpdateProject()
		locate for ID = lcID
		replace Order with lnCurrOrder
		Thisform.UpdateProject()
		locate for Order = lnNewOrder
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdUp.Refresh
		This.Enabled = not empty(Thisform.oEngine.cProjectFile) and ;
			curProject.Order > 1
		
	ENDPROC

	PROCEDURE grdTasks.AfterRowColChange
		lparameters tnColIndex
		Thisform.DisplayTask()
		
	ENDPROC

	PROCEDURE grdTasks.Column4.Check1.Valid
		Thisform.UpdateProject()
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE lblHomePage.Click
		OpenFile('https://github.com/DougHennig/DeployFox')
		
	ENDPROC

	PROCEDURE lblProject.Refresh
		local lcProject, ;
			loMeasure, ;
			lnWidth
		if empty(Thisform.oEngine.cProjectFile)
			This.Caption = ''
		else
			lcProject = Thisform.oEngine.cProjectFile
			loMeasure = newobject('SFGDIMeasureString', 'SFGDIMeasureString.prg')
			lnWidth   = loMeasure.GetWidth(lcProject, This.FontName, This.FontSize)
			if This.Left + lnWidth >= Thisform.shpIncomplete.Left - 10
				lcProject = displaypath(Thisform.oEngine.cProjectFile, 80)
			endif This.Left + lnWidth >= Thisform.shpIncomplete.Left - 10
			This.Caption = 'Project: ' + lcProject
		endif empty(Thisform.oEngine.cProjectFile)
		 
	ENDPROC

	PROCEDURE txtName.InteractiveChange
		dodefault()
		Thisform.cmdSave.Refresh()
		
	ENDPROC

ENDDEFINE

DEFINE CLASS deployfoxsettings AS vfpxbaseform OF "..\packages\vfpxframework\vfpxbaselibrary.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="lblSignCommand" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblIncrement" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="spnIncrement" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="edtSignCommand" UniqueID="" Timestamp="" />

	*<PropValue>
		BindControls = .F.
		BorderStyle = 2
		Caption = "DeployFox Settings"
		DataSession = 2
		DoCreate = .T.
		Height = 160
		Icon = options.ico
		Name = "deployfoxsettings"
		Width = 380
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdCancel' AS vfpxbasecommandbutton WITH ;
		Cancel = .T., ;
		Caption = "Cancel", ;
		Left = 191, ;
		Name = "cmdCancel", ;
		TabIndex = 10, ;
		Top = 125
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'cmdSave' AS vfpxbasecommandbutton WITH ;
		Caption = "Save", ;
		Left = 106, ;
		Name = "cmdSave", ;
		TabIndex = 9, ;
		Top = 125
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'edtSignCommand' AS vfpxbaseeditbox WITH ;
		ControlSource = "Thisform.SignCommand", ;
		Height = 53, ;
		Left = 10, ;
		Name = "edtSignCommand", ;
		TabIndex = 3, ;
		ToolTipText = "The command to sign an EXE; stored in $SignCommand", ;
		Top = 30, ;
		Width = 360
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="editbox" />

	ADD OBJECT 'lblIncrement' AS vfpxbaselabel WITH ;
		Caption = "Task increment", ;
		Left = 10, ;
		Name = "lblIncrement", ;
		TabIndex = 7, ;
		Top = 96, ;
		ZOrderSet = 2
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="label" />

	ADD OBJECT 'lblSignCommand' AS vfpxbaselabel WITH ;
		Caption = "Digitial signing command", ;
		Left = 10, ;
		Name = "lblSignCommand", ;
		TabIndex = 2, ;
		ToolTipText = "The command to sign an EXE; stored in $SignCommand", ;
		Top = 10, ;
		ZOrderSet = 2
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="label" />

	ADD OBJECT 'spnIncrement' AS vfpxbasespinner WITH ;
		ControlSource = "Thisform.TaskIncrement", ;
		KeyboardHighValue = 100, ;
		KeyboardLowValue = 1, ;
		Left = 95, ;
		Name = "spnIncrement", ;
		SpinnerHighValue = 100.00, ;
		SpinnerLowValue =   1.00, ;
		TabIndex = 8, ;
		Top = 92
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="spinner" />
	
	PROCEDURE Init
		lparameters toEngine
		local loDecrypt, ;
			lcKey, ;
			lcProperty, ;
			lcValue
		loDecrypt = newobject('DeployFoxEncryption', 'DeployFoxEncryption.prg')
		lcKey     = GetKey()
		use (toEngine.cAppPath + 'DeployFoxSettings') again shared
		scan
			lcProperty = trim(Setting)
			lcValue    = Value
			if Encrypt and left(lcValue, 2) = '0x'
				lcValue = trim(loDecrypt.Decrypt_AES(strconv(substr(lcValue, 3), 16), lcKey))
			endif Encrypt ...
			do case
				case Type = 'I'
					luValue = int(val(lcValue))
				case Type = 'N'
					luValue = val(lcValue)
				otherwise
					luValue = lcValue
			endcase
			This.AddProperty(lcProperty, luValue)
		endscan
		This.BindControls = .T.
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		Thisform.Release()
		
	ENDPROC

	PROCEDURE cmdSave.Click
		local loDecrypt, ;
			lcKey, ;
			lcProperty, ;
			luValue, ;
			lcValue
		loDecrypt = newobject('DeployFoxEncryption', 'DeployFoxEncryption.prg')
		lcKey     = GetKey()
		scan
			lcProperty = trim(Setting)
			luValue    = evaluate('Thisform.' + lcProperty)
			if Type = 'C'
				lcValue = luValue
			else
				lcValue = transform(luValue)
			endif Type = 'C'
			if Encrypt
				lcValue = '0x' + strconv(loDecrypt.Encrypt_AES(lcValue, lcKey), 15)
			endif Encrypt
			replace Value with lcValue
		endscan
		use
		Thisform.Release()
		
	ENDPROC

ENDDEFINE

DEFINE CLASS deployfoxtemplate AS vfpxbaseform OF "..\packages\vfpxframework\vfpxbaselibrary.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="lstTemplate" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAddOne" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lstProject" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAddAll" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRemoveOne" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRemoveAll" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdOK" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />

	*<PropValue>
		Caption = "Get Tasks From Template"
		DoCreate = .T.
		Height = 294
		Icon = deployfox.ico
		Name = "deployfoxtemplate"
		Width = 580
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdAddAll' AS vfpxbasecommandbutton WITH ;
		Anchor = 128, ;
		Caption = "", ;
		Height = 24, ;
		Left = 280, ;
		Name = "cmdAddAll", ;
		Picture = addall.png, ;
		Top = 63, ;
		Width = 24
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'cmdAddOne' AS vfpxbasecommandbutton WITH ;
		Anchor = 128, ;
		Caption = "", ;
		Height = 24, ;
		Left = 280, ;
		Name = "cmdAddOne", ;
		Picture = add.png, ;
		Top = 35, ;
		Width = 24
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'cmdCancel' AS vfpxbasecommandbutton WITH ;
		Anchor = 36, ;
		Cancel = .T., ;
		Caption = "Cancel", ;
		Left = 293, ;
		Name = "cmdCancel", ;
		Top = 252
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'cmdOK' AS vfpxbasecommandbutton WITH ;
		Anchor = 132, ;
		Caption = "OK", ;
		Default = .F., ;
		Left = 202, ;
		Name = "cmdOK", ;
		Top = 252
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'cmdRemoveAll' AS vfpxbasecommandbutton WITH ;
		Anchor = 128, ;
		Caption = "", ;
		Height = 24, ;
		Left = 280, ;
		Name = "cmdRemoveAll", ;
		Picture = removeall.png, ;
		Top = 144, ;
		Width = 24
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'cmdRemoveOne' AS vfpxbasecommandbutton WITH ;
		Anchor = 128, ;
		Caption = "", ;
		Height = 24, ;
		Left = 280, ;
		Name = "cmdRemoveOne", ;
		Picture = remove.png, ;
		Top = 116, ;
		Width = 24
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'lstProject' AS vfpxbaselistbox WITH ;
		Anchor = 45, ;
		Height = 219, ;
		Left = 320, ;
		Name = "lstProject", ;
		Top = 20, ;
		Width = 250
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="listbox" />

	ADD OBJECT 'lstTemplate' AS vfpxbaselistbox WITH ;
		Anchor = 135, ;
		Height = 219, ;
		Left = 10, ;
		Name = "lstTemplate", ;
		Top = 21, ;
		Width = 250
		*< END OBJECT: ClassLib="..\packages\vfpxframework\vfpxbaselibrary.vcx" BaseClass="listbox" />
	
	PROCEDURE Init
		* Get the tasks in the current project that are from templates.
		
		select Name, ;
				ID, ;
				Order ;
			from curProject ;
			where not empty(Source) ;
			order by Order ;
			into array This.lstProject.aItems
		This.lstProject.Requery()
		if _tally = 0
			dimension This.lstProject.aItems[1, 3]
			This.lstProject.aItems[1, 1] = ''
		endif _tally = 0
		
		* Get the tasks from the template that aren't in the project.
		
		select Name, ;
				ID, ;
				Order ;
			from Template ;
			order by Order ;
			into array laItems
		lnItems = _tally
		for lnI = alen(This.lstProject.aItems, 1) to 1 step -1
			lnPos = ascan(laItems, This.lstProject.aItems[lnI, 2], -1, -1, 2, 8)
			if lnPos > 0
				adel(laItems, lnPos)
				lnItems = lnItems - 1
			endif lnPos > 0
		next lnI
		if lnItems > 0
			dimension laItems[lnItems, 3]
			acopy(laItems, This.lstTemplate.aItems)
		else
			dimension This.lstTemplate.aItems[1, 3]
			This.lstTemplate.aItems[1, 1] = ''
		endif lnItems > 0
		This.lstTemplate.Requery()
		This.lstTemplate.ListIndex = 1
		This.lstProject.ListIndex = 1
		
		This.MinWidth  = This.Width
		This.MinHeight = This.Height
		
	ENDPROC

	PROCEDURE cmdAddAll.Click
		lnItems = iif(empty(Thisform.lstProject.aItems[1, 1]), 0, alen(Thisform.lstProject.aItems, 1))
		for lnI = 1 to alen(Thisform.lstTemplate.aItems, 1)
			lnItems = lnItems + 1
			dimension Thisform.lstProject.aItems[lnItems, 3]
			Thisform.lstProject.aItems[lnItems, 1] = Thisform.lstTemplate.aItems[lnI, 1]
			Thisform.lstProject.aItems[lnItems, 2] = Thisform.lstTemplate.aItems[lnI, 2]
			Thisform.lstProject.aItems[lnItems, 3] = Thisform.lstTemplate.aItems[lnI, 3]
		next lnI
		asort(Thisform.lstProject.aItems, 3)
		dimension Thisform.lstTemplate.aItems[1, 3]
		Thisform.lstTemplate.aItems[1, 1] = ''
		Thisform.lstTemplate.aItems[1, 2] = ''
		Thisform.lstTemplate.aItems[1, 3] = 0
		Thisform.lstTemplate.Requery()
		Thisform.lstProject.Requery()
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdAddAll.Refresh
		This.Enabled = not empty(Thisform.lstTemplate.aItems[1, 1])
		
	ENDPROC

	PROCEDURE cmdAddOne.Click
		lnIndex = Thisform.lstTemplate.ListIndex
		lnItems = iif(empty(Thisform.lstProject.aItems[1, 1]), 1, alen(Thisform.lstProject.aItems, 1) + 1)
		dimension Thisform.lstProject.aItems[lnItems, 3]
		Thisform.lstProject.aItems[lnItems, 1] = Thisform.lstTemplate.aItems[lnIndex, 1]
		Thisform.lstProject.aItems[lnItems, 2] = Thisform.lstTemplate.aItems[lnIndex, 2]
		Thisform.lstProject.aItems[lnItems, 3] = Thisform.lstTemplate.aItems[lnIndex, 3]
		asort(Thisform.lstProject.aItems, 3)
		adel(Thisform.lstTemplate.aItems, lnIndex)
		lnItems = alen(Thisform.lstTemplate.aItems, 1) - 1
		if lnItems = 0
			Thisform.lstTemplate.aItems[1, 1] = ''
			lnItems = 1
		endif lnItems = 0
		dimension Thisform.lstTemplate.aItems[lnItems, 3]
		Thisform.lstTemplate.Requery()
		Thisform.lstProject.Requery()
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdAddOne.Refresh
		lnIndex = Thisform.lstTemplate.ListIndex
		This.Enabled = lnIndex > 0 and not empty(Thisform.lstTemplate.aItems[lnIndex, 1])
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		Thisform.Release()
		
	ENDPROC

	PROCEDURE cmdOK.Click
		create cursor TemplateTasks (ID C(10))
		for lnI = 1 to alen(Thisform.lstProject.aItems, 1)
			insert into TemplateTasks values (Thisform.lstProject.aItems[lnI, 2])
		next lnI
		Thisform.Release()
		
	ENDPROC

	PROCEDURE cmdRemoveAll.Click
		lnItems = iif(empty(Thisform.lstTemplate.aItems[1, 1]), 0, alen(Thisform.lstTemplate.aItems, 1))
		for lnI = 1 to alen(Thisform.lstProject.aItems, 1)
			lnItems = lnItems + 1
			dimension Thisform.lstTemplate.aItems[lnItems, 3]
			Thisform.lstTemplate.aItems[lnItems, 1] = Thisform.lstProject.aItems[lnI, 1]
			Thisform.lstTemplate.aItems[lnItems, 2] = Thisform.lstProject.aItems[lnI, 2]
			Thisform.lstTemplate.aItems[lnItems, 3] = Thisform.lstProject.aItems[lnI, 3]
		next lnI
		asort(Thisform.lstTemplate.aItems, 3)
		dimension Thisform.lstProject.aItems[1, 3]
		Thisform.lstProject.aItems[1, 1] = ''
		Thisform.lstProject.aItems[1, 2] = ''
		Thisform.lstProject.aItems[1, 3] = 0
		Thisform.lstTemplate.Requery()
		Thisform.lstProject.Requery()
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdRemoveAll.Refresh
		This.Enabled = not empty(Thisform.lstProject.aItems[1, 1])
		
	ENDPROC

	PROCEDURE cmdRemoveOne.Click
		lnIndex = Thisform.lstProject.ListIndex
		lnItems = iif(empty(Thisform.lstTemplate.aItems[1, 1]), 1, alen(Thisform.lstTemplate.aItems, 1) + 1)
		dimension Thisform.lstTemplate.aItems[lnItems, 3]
		Thisform.lstTemplate.aItems[lnItems, 1] = Thisform.lstProject.aItems[lnIndex, 1]
		Thisform.lstTemplate.aItems[lnItems, 2] = Thisform.lstProject.aItems[lnIndex, 2]
		Thisform.lstTemplate.aItems[lnItems, 3] = Thisform.lstProject.aItems[lnIndex, 3]
		asort(Thisform.lstTemplate.aItems, 3)
		adel(Thisform.lstProject.aItems, lnIndex)
		lnItems = alen(Thisform.lstProject.aItems, 1) - 1
		if lnItems = 0
			Thisform.lstProject.aItems[1, 1] = ''
			lnItems = 1
		endif lnItems = 0
		dimension Thisform.lstProject.aItems[lnItems, 3]
		Thisform.lstTemplate.Requery()
		Thisform.lstProject.Requery()
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdRemoveOne.Refresh
		lnIndex = Thisform.lstProject.ListIndex
		This.Enabled = lnIndex > 0 and not empty(Thisform.lstProject.aItems[lnIndex, 1])
		
	ENDPROC

ENDDEFINE
